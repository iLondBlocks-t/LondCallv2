rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function callExists(callId) {
      return exists(/databases/$(database)/documents/calls/$(callId));
    }
    function isCallParticipant(callId) {
      return signedIn() && callExists(callId) &&
        request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participants;
    }
    function isCaller(callId) {
      return isCallParticipant(callId) &&
        get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid;
    }
    function isCallee(callId) {
      return isCallParticipant(callId) &&
        get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid;
    }

    // Only deliberately public profile fields are stored here. Email and FCM tokens never are.
    match /usersPublic/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid) && request.resource.data.uid == uid;
      allow update: if isSelf(uid) && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    match /usersPrivate/{uid} {
      allow read, write: if isSelf(uid);
      allow delete: if false;
    }

    match /usernames/{usernameLowercase} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        !exists(/databases/$(database)/documents/usernames/$(usernameLowercase)) &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // A friendship is immediately visible to both participants on every device.
    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2 &&
        request.resource.data.status == 'active';
      allow update: if signedIn() && request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants;
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;
    }

    match /calls/{callId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.callerUid &&
        request.resource.data.callerUid != request.resource.data.calleeUid &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2 &&
        request.resource.data.status == 'ringing';
      allow update: if signedIn() && request.auth.uid in resource.data.participants &&
        request.resource.data.callerUid == resource.data.callerUid &&
        request.resource.data.calleeUid == resource.data.calleeUid &&
        request.resource.data.participants == resource.data.participants &&
        request.resource.data.type == resource.data.type;
      allow delete: if false;

      match /signaling/{docId} {
        allow read: if isCallParticipant(callId);
        allow create, update: if isCallParticipant(callId) &&
          ((docId == 'offer' && isCaller(callId)) || (docId == 'answer' && isCallee(callId)));
        allow delete: if isCallParticipant(callId);
      }
      match /callerCandidates/{candidateId} {
        allow read: if isCallParticipant(callId);
        allow create: if isCaller(callId);
        allow update, delete: if isCallParticipant(callId);
      }
      match /calleeCandidates/{candidateId} {
        allow read: if isCallParticipant(callId);
        allow create: if isCallee(callId);
        allow update, delete: if isCallParticipant(callId);
      }
    }

    match /callHistory/{uid}/items/{historyId} {
      allow read, write: if isSelf(uid);
      allow delete: if isSelf(uid);
    }
  }
}
