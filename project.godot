; Echofang - a landscape-first metroidvania vertical slice
; Godot 4.x
config_version=5

[application]
config/name="Echofang"
config/description="A hand-drawn silhouette metroidvania vertical slice"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.035, 0.047, 0.09, 1)

[autoload]
GameState="*res://scripts/core/game_state.gd"

[display]

[display/window]
size/viewport_width=1280
size/viewport_height=720
size/window_width_override=1280
size/window_height_override=720
stretch/mode="canvas_items"
handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.031, 0.065, 1)
textures/default_filters/use_nearest_mipmap_filter=false
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[physics]
common/physics_ticks_per_second=60
2d/default_gravity=1550.0

[input]
move_left={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194311), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]}
move_right={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194313), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]}
move_up={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320), Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]}
move_down={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322), Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]}
jump={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventKey,"physical_keycode":74), Object(InputEventJoypadButton,"button_index":0)]}
attack={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":88), Object(InputEventKey,"physical_keycode":75), Object(InputEventMouseButton,"button_index":1), Object(InputEventJoypadButton,"button_index":2)]}
dash={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":67), Object(InputEventKey,"physical_keycode":76), Object(InputEventJoypadButton,"button_index":1)]}
ability_1={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":90), Object(InputEventKey,"physical_keycode":4194321), Object(InputEventJoypadButton,"button_index":3)]}
ability_2={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":86), Object(InputEventKey,"physical_keycode":4194322), Object(InputEventJoypadButton,"button_index":4)]}
interact={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventKey,"physical_keycode":70), Object(InputEventJoypadButton,"button_index":7)]}

[layer_names]
2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Enemies"

[gui]
theme/default_font_multichannel_signed_distance_field=true

[android]
input_devices/pointing/emulate_touch_from_mouse=true
input_devices/pointing/emulate_mouse_from_touch=true
orientation=0

[display/window/handheld]
orientation=0
